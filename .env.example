# Optional live flight source. Obtain a key from Ignav; never expose it in client code.
IGNAV_API_KEY=

# Optional override for the automatically discovered public ITA Matrix web-app key.
# Keep server-side; this is not a supported API credential or access guarantee.
ITA_MATRIX_API_KEY=

# Expedia Travel Redirect credentials issued during partner onboarding.
EXPEDIA_TRAVEL_REDIRECT_KEY=
EXPEDIA_TRAVEL_REDIRECT_AUTHORIZATION=

# Omkar Expedia Scraper API key. One adult/one-way only; currency must be explicit in results.
OMKAR_API_KEY=

# Skyscanner Travel API partner key.
SKYSCANNER_API_KEY=

# Air Canada NDC values are issued after seller onboarding and certification.
AIR_CANADA_NDC_API_KEY=
AIR_CANADA_NDC_SELLER_ID=
AIR_CANADA_NDC_IATA_NUMBER=
AIR_CANADA_NDC_AGENCY_ID=
# Optional: use Air Canada's GOLD/certification URL when approved for it.
AIR_CANADA_NDC_BASE_URL=https://ndcpartners.aircanada.com/agg/ndc/17.2/v1

# Optional shared SQLite path for the web app and independent flight worker.
# Defaults to .cache/jobs/search.sqlite in the project directory.
TRAVEL_JOB_DB=

# Local per-provider HTTP request gap (100–60000 milliseconds; default 1000).
# Does not represent a provider's actual quota or permitted rate.
TRAVEL_SOURCE_GAP_MS=1000

# Native Google economy round trips; requires a usable Chromium executable.
# Tries at most three eligible outbounds within a 45-second query deadline.
# Manual access checks stop the source; seller continuation is never automated.
TRAVEL_GOOGLE_ROUND_TRIP=0

# Matrix submitted-search response window in milliseconds (1000–180000).
TRAVEL_MATRIX_RESPONSE_TIMEOUT_MS=90000
