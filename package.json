{
  "name": "travel-hunter-pro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:stack": "node scripts/local-stack.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "check:markdown-links": "node scripts/check-markdown-links.mjs",
    "jobs:database": "node scripts/job-database.mjs",
    "worker": "node --env-file-if-exists=.env.local scripts/search-worker.mjs",
    "check:local-stack": "node scripts/check-local-stack.mjs",
    "check:search-settings": "node scripts/check-search-settings-ui.mjs",
    "check:accessible-controls": "node scripts/check-accessible-controls-ui.mjs",
    "check:responsive-ui": "node scripts/check-responsive-ui.mjs",
    "check:theme-contrast": "node scripts/check-theme-contrast-ui.mjs",
    "check:hotel-occupancy": "node scripts/check-hotel-occupancy-ui.mjs",
    "check:hotel-flight-switch": "node scripts/check-hotel-flight-switch-ui.mjs",
    "check:flight-hotel-demand": "node scripts/check-flight-hotel-demand-ui.mjs",
    "check:booking-demand": "node scripts/check-booking-demand-ui.mjs",
    "check:package-infant-guidance": "node scripts/check-package-infant-guidance-ui.mjs",
    "check:hotel-room-handoff": "node scripts/check-hotel-room-handoff-ui.mjs",
    "check:route-settings": "node scripts/check-route-settings-ui.mjs",
    "check:separate-ticket-results": "node scripts/check-separate-ticket-results-ui.mjs",
    "check:party-partition": "node scripts/check-party-partition-ui.mjs",
    "check:matrix-price-observation": "node scripts/check-matrix-price-observation-ui.mjs",
    "check:region-coverage": "node scripts/check-region-coverage-ui.mjs",
    "check:calendar-source": "node scripts/check-calendar-source-ui.mjs",
    "check:calendar-streaming": "node scripts/check-calendar-streaming-ui.mjs",
    "check:calendar-ranges": "node scripts/check-calendar-ranges-ui.mjs",
    "check:flight-default": "node scripts/check-flight-default-ui.mjs",
    "check:carrier-guidance": "node scripts/check-carrier-guidance-ui.mjs",
    "check:guardian-picker": "node scripts/check-guardian-picker-ui.mjs",
    "check:booking-links": "node scripts/check-booking-links-ui.mjs",
    "check:worker-status": "node scripts/check-worker-status-ui.mjs",
    "check:worker-retry-status": "TRAVEL_CHECK_RETRY_STATUS=1 node scripts/check-flight-default-ui.mjs",
    "check:job-recovery": "node scripts/check-job-database-recovery.mjs",
    "check:member-offers": "node scripts/check-member-offers-ui.mjs",
    "check:flight-streaming": "node scripts/check-flight-streaming-ui.mjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "api-anything": "^0.2.0",
    "next": "16.4.6",
    "playwright-core": "1.65.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
